---
const year = new Date().getFullYear();
---
<footer class="py-10">
  <div class="flex items-center justify-between">
    <div>&copy; {year} Calvin Otewa</div>
    <div class="text-sm">
      Want to write me? Contact me on
      <a
        class="underline underline-offset-2 decoration-royal-200 hover:decoration-2"
        href="https://linkedin.com/in/otewa"
        target="_blank"
        rel="noopener noreferrer"
      >LinkedIn</a>
      <span class="px-1 text-royal-200">&middot;</span>
      <a
        class="underline underline-offset-2 decoration-royal-200 hover:decoration-2"
        href="/rss.xml"
      >RSS</a>
    </div>
  </div>
</footer>