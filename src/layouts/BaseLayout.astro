---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A Hello World template site built with Astro, React, MDX, and Tailwind CSS.' } = Astro.props;
---
<!doctype html>
<html lang="en" dir="ltr" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#7851a9" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body
    class="flex flex-col min-h-screen mx-auto text-lg leading-7 max-w-7xl bg-royal-500 text-white px-6 sm:px-14 md:px-24 lg:px-32"
  >
    <div id="the-top" class="absolute flex self-center">
      <a
        class="px-3 py-1 text-sm -translate-y-8 rounded-b-lg bg-royal-200 focus:translate-y-0"
        href="#main-content"
      >
        <span class="font-bold text-royal-700 pr-2">&darr;</span>Skip to main content
      </a>
    </div>
    <Header />
    <div class="relative flex flex-col grow">
      <main id="main-content" class="grow">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>